# --- Microsoft Secure Boot certificates (enrolled into edk2-aarch64-vars-ms.fd)
# From Microsoft's "Windows Secure Boot Key Creation and Management Guidance"
# (learn.microsoft.com/windows-hardware/manufacture/desktop/windows-secure-boot-key-creation-and-management-guidance).
# The go.microsoft.com/fwlink links given there redirect to the pkiops URLs
# below (resolved 2026-10-21). Hash source: computed from the download; each
# matched byte for byte (SHA-256 of the DER) the copy bundled in virt-firmware
# 26.10 (virt/firmware/certs/microsoft.com/*.pem). Subjects / validity checked
# with openssl x509. The 2011 certificates have passed their notAfter dates;
# UEFI image verification does not check certificate time, and Windows boot
# media is still signed by the 2011 PCA, so they stay enrolled next to the 2023 CAs.
# KEK: fwlink LinkId=321185, CN=Microsoft Corporation KEK CA 2011
MS_KEK_2011_VERSION=2011-06-24
MS_KEK_2011_FILE=MicCorKEKCA2011_2011-06-24.crt
MS_KEK_2011_URL=https://www.microsoft.com/pkiops/certs/MicCorKEKCA2011_2011-06-24.crt
MS_KEK_2011_SHA256=a1117f516a32cefcba3f2d1ace10a87972fd6bbe8fe0d0b996e09e65d802a503
# KEK: fwlink linkid=2239775, CN=Microsoft Corporation KEK 2K CA 2023
MS_KEK_2023_VERSION=2023-03-02
MS_KEK_2023_FILE=microsoft-corporation-kek-2k-ca-2023.crt
MS_KEK_2023_URL=https://www.microsoft.com/pkiops/certs/microsoft%20corporation%20kek%202k%20ca%202023.crt
MS_KEK_2023_SHA256=3cd3f0309edae228767a976dd40d9f4affc4fbd5218f2e8cc3c9dd97e8ac6f9d
# db: fwlink linkid=321192, CN=Microsoft Windows Production PCA 2011
MS_WIN_PCA_2011_VERSION=2011-10-19
MS_WIN_PCA_2011_FILE=MicWinProPCA2011_2011-10-19.crt
MS_WIN_PCA_2011_URL=https://www.microsoft.com/pkiops/certs/MicWinProPCA2011_2011-10-19.crt
MS_WIN_PCA_2011_SHA256=e8e95f0733a55e8bad7be0a1413ee23c51fcea64b3c8fa6a786935fddcc71961
# db: fwlink linkid=2239776, CN=Windows UEFI CA 2023
MS_WIN_UEFI_2023_VERSION=2023-06-13
MS_WIN_UEFI_2023_FILE=windows-uefi-ca-2023.crt
MS_WIN_UEFI_2023_URL=https://www.microsoft.com/pkiops/certs/windows%20uefi%20ca%202023.crt
MS_WIN_UEFI_2023_SHA256=076f1fea90ac29155ebf77c17682f75f1fdd1be196da302dc8461e350a9ae330
# db: fwlink linkid=321194, CN=Microsoft Corporation UEFI CA 2011 (third-party)
MS_UEFI_2011_VERSION=2011-06-27
MS_UEFI_2011_FILE=MicCorUEFCA2011_2011-06-27.crt
MS_UEFI_2011_URL=https://www.microsoft.com/pkiops/certs/MicCorUEFCA2011_2011-06-27.crt
MS_UEFI_2011_SHA256=48e99b991f57fc52f76149599bff0a58c47154229b9f8d603ac40d3500248507
# db: fwlink linkid=2239872, CN=Microsoft UEFI CA 2023 (third-party)
MS_UEFI_2023_VERSION=2023-06-13
MS_UEFI_2023_FILE=microsoft-uefi-ca-2023.crt
MS_UEFI_2023_URL=https://www.microsoft.com/pkiops/certs/microsoft%20uefi%20ca%202023.crt
MS_UEFI_2023_SHA256=f6124e34125bee3fe6d79a574eaa7b91c0e7bd9d929c1a321178efd611dad901
MS_KEK_CERTS="MS_KEK_2011 MS_KEK_2023"
MS_DB_CERTS="MS_WIN_PCA_2011 MS_WIN_UEFI_2023 MS_UEFI_2011 MS_UEFI_2023"

# Sources shipped in build/qemu-src (GPL corresponding source + licences).
# SHIPPED_SOURCES end up (compiled) in the app. The build-only tools and inputs
# (pkgconf, meson, ninja, setuptools, wheel, tomli, libtasn1, GNU autotools,
# ACPICA, virt-firmware and its wheels, the Microsoft certificates) are also copied into
# qemu-src/sources so the build can be reproduced offline, except LLVM
# (EXTERNAL_TOOLS: fetched from its URL, too large for the payload).
SHIPPED_SOURCES="QEMU GLIB PROXY_LIBINTL PCRE2 LIBFFI PIXMAN SLIRP SPICE_PROTOCOL DTC OPENSSL JSON_GLIB LIBTPMS SWTPM"
BUILD_SOURCES="PKGCONF MESON NINJA SETUPTOOLS WHEEL TOMLI LIBTASN1 M4 AUTOCONF AUTOMAKE LIBTOOL ACPICA VIRT_FIRMWARE CRYPTOGRAPHY CFFI PYCPARSER TYPING_EXTENSIONS $MS_KEK_CERTS $MS_DB_CERTS"
ALL_SOURCES="$SHIPPED_SOURCES $BUILD_SOURCES"
EXTERNAL_TOOLS="LLVM"

# Lowest macOS the bundled binaries must run on (global constraint: macOS 14+).
MACOS_DEPLOYMENT_TARGET=14.0

# --- VMForMac firmware branding ---------------------------------------------
# Strings compiled into the edk2 build (PcdFirmwareVendor, PcdFirmwareVersionString,
# PcdFirmwareReleaseDateString: UEFI shell `ver`, the boot banner and the
# fallback SMBIOS type 0) and passed by the app as QEMU `-smbios type=0`
# (vmf_qemu::cmdline::FIRMWARE_*; a unit test keeps them equal to these).
# The version is the QEMU version plus the vmformac-qemu-src release revision.
# The boot logo is scripts/qemu/branding/vmformac-logo.png (see make-logo.sh).
VMFORMAC_FIRMWARE_VENDOR="VMForMac BIOS"
VMFORMAC_FIRMWARE_VERSION=11.1.2-r2
VMFORMAC_FIRMWARE_DATE=10/22/2026
