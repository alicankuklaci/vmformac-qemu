+    fhost4->sin_port = uh->uh_dport;
+    so = udp_solookup(slirp, &lhost, &fhost);
 
     if (so == NULL) {
         /*
@@ -303,6 +308,33 @@
     error = ip_output(so, m);
 
     return (error);
+}
+
+/*
+ * Find the socket for a datagram from the guest.  Each (guest source,
+ * destination) pair has its own host socket, which sosendto() connect()s to
+ * that destination: the macOS App Sandbox, without the
+ * com.apple.security.network.server entitlement, refuses to deliver datagrams
+ * to an unconnected UDP socket ("deny network-inbound"), but allows replies on
+ * a connected one (network.client).  Host-forwarding sockets (SS_HOSTFWD) are
+ * bound listeners and stay keyed by the guest address alone, as before.
+ */
+struct socket *udp_solookup(Slirp *slirp, const struct sockaddr_storage *lhost,
+                            const struct sockaddr_storage *fhost)
+{
+    struct socket *so;
+
+    so = solookup(&slirp->udp_last_so, &slirp->udb, lhost, fhost);
+    if (so != NULL) {
+        return so;
+    }
+    for (so = slirp->udb.so_next; so != &slirp->udb; so = so->so_next) {
+        if ((so->so_state & SS_HOSTFWD) &&
+            sockaddr_equal(&so->lhost.ss, lhost)) {
+            return so;
+        }
+    }
+    return NULL;
 }
 
 slirp_os_socket udp_attach(struct socket *so, unsigned short af)
--- a/src/udp.h
+++ b/src/udp.h
@@ -83,6 +83,8 @@
 void udp_input(register struct mbuf *, int);
 /* Create a host UDP socket, bound to this socket */
 slirp_os_socket udp_attach(struct socket *, unsigned short af);
+struct socket *udp_solookup(Slirp *slirp, const struct sockaddr_storage *lhost,
+                            const struct sockaddr_storage *fhost);
 /* Destroy socket */
 void udp_detach(struct socket *);
 
